{
    "name": "@ai-meeting-bot/worker",
    "version": "1.0.0",
    "description": "AI Meeting Bot Worker Service - Job Processing with BullMQ",
    "main": "dist/index.js",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "build": "tsc",
        "start": "node dist/index.js",
        "test": "vitest",
        "lint": "eslint src tests --ext .ts",
        "lint:fix": "eslint src tests --ext .ts --fix",
        "format": "prettier --write src tests",
        "format:check": "prettier --check src tests",
        "typecheck": "tsc --noEmit",
        "audit": "npm audit"
    },
    "dependencies": {
        "@ai-meeting-bot/shared": "file:../shared",
        "@prisma/client": "^5.7.1",
        "bullmq": "^4.15.4",
        "ioredis": "^5.3.2",
        "pino": "^8.17.2",
        "pino-pretty": "^10.3.1",
        "@opentelemetry/api": "^1.7.0",
        "@opentelemetry/auto-instrumentations-node": "^0.40.3",
        "@opentelemetry/sdk-node": "^0.46.0",
        "openai": "^4.24.7",
        "minio": "^7.1.3",
        "zod": "^3.22.4"
    },
    "devDependencies": {
        "@types/node": "^20.10.6",
        "@typescript-eslint/eslint-plugin": "^6.17.0",
        "@typescript-eslint/parser": "^6.17.0",
        "eslint": "^8.56.0",
        "prettier": "^3.1.1",
        "prisma": "^5.7.1",
        "tsx": "^4.6.2",
        "typescript": "^5.3.3",
        "vitest": "^1.1.3"
    },
    "engines": {
        "node": ">=18.0.0"
    }
}