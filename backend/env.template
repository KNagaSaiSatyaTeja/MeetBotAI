# =================================
# AI Meeting Bot Backend Configuration
# =================================
# Copy this file to .env and configure the values for your environment

# =================================
# Application Settings
# =================================
NODE_ENV=development
PORT=5000
HOST=0.0.0.0

# =================================
# Database Configuration
# =================================
# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:password@localhost:5432/aimeet_dev

# =================================
# Redis Configuration
# =================================
# Redis connection string for job queues and caching
REDIS_URL=redis://localhost:6379

# =================================
# Authentication & Security
# =================================
# JWT Secret for token signing (generate with: openssl rand -base64 32)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# API Rate limiting (requests per minute)
API_RATE_LIMIT=60

# CORS Origins (comma-separated list for production)
# CORS_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# =================================
# Storage Configuration (S3/MinIO)
# =================================
# For local development with MinIO
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=ai-meeting-bot
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# For AWS S3 (comment out S3_ENDPOINT for AWS)
# S3_BUCKET=your-s3-bucket-name
# S3_ACCESS_KEY=your-aws-access-key
# S3_SECRET_KEY=your-aws-secret-key
# S3_REGION=us-east-1

# =================================
# AI Providers Configuration
# =================================

# LLM Provider (openai, azure, gemini, hf)
LLM_PROVIDER=openai

# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4

# Azure OpenAI Configuration (if using azure)
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_KEY=your-azure-openai-key
# AZURE_OPENAI_DEPLOYMENT=your-deployment-name

# Google Gemini Configuration (if using gemini)
# GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL=gemini-pro

# Hugging Face Configuration (if using hf)
# HF_API_KEY=your-huggingface-api-key
# HF_MODEL=microsoft/DialoGPT-large

# =================================
# Speech-to-Text Configuration
# =================================

# STT Provider (whisper, aws, gcp, azure)
STT_PROVIDER=whisper

# Whisper Configuration (uses OpenAI API)
WHISPER_MODEL=base
# Uses OPENAI_API_KEY from above

# AWS Transcribe Configuration (if using aws)
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key

# Google Cloud Speech-to-Text (if using gcp)
# GCP_PROJECT_ID=your-gcp-project-id
# GCP_KEY_FILE=path/to/your/service-account-key.json

# Azure Speech Services (if using azure)
# AZURE_SPEECH_KEY=your-azure-speech-key
# AZURE_SPEECH_REGION=your-azure-speech-region

# =================================
# Observability & Monitoring
# =================================
# Metrics endpoint port
METRICS_PORT=9464

# =================================
# Service Ports
# =================================
# Backend API port
PORT=5000

# Frontend port (for reference)
FRONTEND_PORT=3000

# Redis port
REDIS_PORT=6379

# PostgreSQL port
POSTGRES_PORT=5432

# MinIO ports
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# OpenTelemetry configuration (optional)
# OTEL_SERVICE_NAME=ai-meeting-bot-backend
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# =================================
# Development Tools
# =================================
# Enable Swagger UI in development
ENABLE_SWAGGER=true

# =================================
# Quick Setup Instructions
# =================================
# 1. Install and start PostgreSQL
# 2. Install and start Redis
# 3. For local file storage, install and start MinIO:
#    docker run -p 9000:9000 -p 9001:9001 minio/minio server /data --console-address ":9001"
# 4. Create database: createdb aimeet_dev
# 5. Run migrations: npm run db:generate && npm run db:push
# 6. Start the server: npm run dev
