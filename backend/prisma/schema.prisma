// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  orgId        String?  // Optional for individual users
  role         UserRole @default(USER)
  email        String   @unique
  passwordHash String?  // Direct password storage
  name         String?
  companyName  String?
  provider     String   @default("email") // email, google, microsoft, zoom
  oauthTokens  Json     @default("{}")
  consentFlags Json     @default("{}")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  organization Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)
  meetings     Meeting[]
  apiTokens    ApiToken[]
  webhooks     Webhook[]
  auditLogs    AuditLog[]
  adminLogs    AdminLog[]    @relation("AdminLogs")

  @@map("users")
}

model Organization {
  id            String   @id @default(cuid())
  name          String
  plan          String   @default("free") // free, pro, enterprise
  region        String   @default("us") // us, eu, etc.
  retentionDays Int      @default(30)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  users     User[]
  meetings  Meeting[]
  apiKeys   ApiKey[]
  auditLogs AuditLog[]
  webhooks  Webhook[]
  botApiClients BotApiClient[]

  @@map("organizations")
}

model Meeting {
  id            String        @id @default(cuid())
  userId        String        // Owner of the meeting
  orgId         String?       // Optional organization
  title         String
  platform      String        // zoom, google-meet, teams
  meetingLink   String?
  scheduledAt   DateTime?
  startedAt     DateTime?
  endedAt       DateTime?
  status        MeetingStatus @default(SCHEDULED)
  consentFlags  Json          @default("{}")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)
  recordings   Recording[]
  transcripts  Transcript[]
  summaries    Summary[]
  bots         MeetingsBot[]
  moms         MeetingMOM[]

  @@map("meetings")
}

model Recording {
  id               String    @id @default(cuid())
  meetingId        String
  hasVideo         Boolean   @default(false)
  audioUrl         String?
  videoUrl         String?
  sizeBytes        BigInt    @default(0)
  checksum         String?
  storageRegion    String    @default("us")
  encryptionMeta   Json      @default("{}")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Relations
  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@map("recordings")
}

model Transcript {
  id              String    @id @default(cuid())
  meetingId       String
  language        String    @default("en")
  text            String
  wordsJson       Json      @default("[]")
  speakerTurnsJson Json     @default("[]")
  accuracy        Float?
  readyAt         DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@map("transcripts")
}

model Summary {
  id               String    @id @default(cuid())
  meetingId        String
  model            String    @default("gpt-4")
  summaryText      String
  decisionsJson    Json      @default("[]")
  actionItemsJson  Json      @default("[]")
  participantsJson Json      @default("[]")
  readyAt          DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Relations
  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@map("summaries")
}

// New: Meeting Bot instance tracking
model MeetingsBot {
  id          String     @id @default(cuid())
  meetingId   String
  platform    String     // zoom, google-meet, teams
  status      BotStatus  @default(IDLE)
  joinLink    String?
  startedAt   DateTime? 
  endedAt     DateTime?
  metaJson    Json       @default("{}")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Relations
  meeting     Meeting    @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  logs        MeetingBotLog[]

  @@index([meetingId])
  @@map("meetings_bots")
}

// New: Bot lifecycle and event logs
model MeetingBotLog {
  id        String    @id @default(cuid())
  botId     String
  level     LogLevel  @default(INFO)
  event     String
  message   String
  metaJson  Json      @default("{}")
  createdAt DateTime  @default(now())

  // Relations
  bot       MeetingsBot @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@index([botId])
  @@map("meeting_bot_logs")
}

// New: Structured Minutes of Meeting (MOM)
model MeetingMOM {
  id               String    @id @default(cuid())
  meetingId        String
  summaryText      String
  decisionsJson    Json      @default("[]")
  actionItemsJson  Json      @default("[]")
  attendeesJson    Json      @default("[]")
  topicsJson       Json      @default("[]")
  readyAt          DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Relations
  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId])
  @@map("meeting_mom")
}

// New: Bot API clients for B2B access
model BotApiClient {
  id         String   @id @default(cuid())
  orgId      String
  name       String
  hash       String   @unique // bcrypt hash of the API key
  scopes     String[] @default([])
  rateLimit  Int      @default(60)
  lastUsedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("bot_api_clients")
}

model Job {
  id          String    @id @default(cuid())
  type        String // TRANSCRIBE, SUMMARIZE, RETENTION, WEBHOOK
  status      JobStatus @default(PENDING)
  attempts    Int       @default(0)
  payloadJson Json      @default("{}")
  error       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("jobs")
}

// User API tokens for B2B integration
model ApiToken {
  id         String   @id @default(cuid())
  userId     String
  token      String   @unique // The actual token (hashed)
  label      String?
  status     String   @default("active") // active, revoked
  lastUsedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("api_tokens")
}

model ApiKey {
  id         String   @id @default(cuid())
  orgId      String
  hash       String   @unique // bcrypt hash of the key
  label      String
  scopes     String[] @default([]) // meetings:read, meetings:write, etc.
  lastUsedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("api_keys")
}

model AuditLog {
  id        String    @id @default(cuid())
  orgId     String
  actorType ActorType
  actorId   String
  action    String // api_key_created, data_exported, webhook_delivered, etc.
  metaJson  Json      @default("{}")
  createdAt DateTime  @default(now())

  // Relations
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

model Webhook {
  id        String   @id @default(cuid())
  userId    String   // User who owns this webhook
  orgId     String?  // Optional organization
  url       String
  secret    String   // HMAC secret
  events    String[] @default([]) // meeting.processed, meeting.failed, etc.
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)
  deliveries   WebhookDelivery[]

  @@map("webhooks")
}

model WebhookDelivery {
  id           String            @id @default(cuid())
  webhookId    String
  event        String
  payloadJson  Json
  status       WebhookStatus     @default(PENDING)
  attempts     Int               @default(0)
  responseCode Int?
  responseBody String?
  nextRetryAt  DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  // Relations
  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@map("webhook_deliveries")
}

// Admin action logs
model AdminLog {
  id              String    @id @default(cuid())
  adminId         String    // Admin user who performed the action
  action          String    // Action performed
  targetUserId    String?   // Target user (if applicable)
  targetMeetingId String?   // Target meeting (if applicable)
  metaJson        Json      @default("{}")
  createdAt       DateTime  @default(now())

  // Relations
  admin User @relation("AdminLogs", fields: [adminId], references: [id], onDelete: Cascade)

  @@map("admin_logs")
}

// Enums
enum UserRole {
  USER
  ADMIN
  SERVICE
}

enum MeetingStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  FAILED
  CANCELLED
}

enum JobStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
  CANCELLED
}

enum ActorType {
  USER
  API_KEY
  SYSTEM
}

enum WebhookStatus {
  PENDING
  DELIVERED
  FAILED
  CANCELLED
}

// New: Bot status enum
enum BotStatus {
  IDLE
  JOINING
  IN_MEETING
  RECORDING
  LEAVING
  ENDED
  FAILED
}

// New: Log level enum for bot logs
enum LogLevel {
  DEBUG
  INFO
  WARN
  ERROR
}
