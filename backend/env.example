# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/meetbotai"
DIRECT_URL="postgresql://username:password@localhost:5432/meetbotai"

# JWT Secret (generate a secure random string)
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# Redis (Optional - for background jobs)
# REDIS_URL="redis://localhost:6379"

# Server Configuration
PORT=5000
HOST=0.0.0.0
NODE_ENV=development

# Enable API Documentation
ENABLE_SWAGGER=true

# Storage Configuration (Optional - for file uploads)
# AWS_ACCESS_KEY_ID="your-access-key"
# AWS_SECRET_ACCESS_KEY="your-secret-key"
# AWS_REGION="us-east-1"
# AWS_S3_BUCKET="meetbotai-recordings"

# AI Services (Optional - for transcription and summarization)
# OPENAI_API_KEY="your-openai-key"
# GOOGLE_AI_API_KEY="your-gemini-key"

# OAuth Configuration (Optional)
# GOOGLE_CLIENT_ID="your-google-client-id"
# GOOGLE_CLIENT_SECRET="your-google-client-secret"
# MICROSOFT_CLIENT_ID="your-microsoft-client-id"
# MICROSOFT_CLIENT_SECRET="your-microsoft-client-secret"

# Supabase Configuration (Optional - for OAuth)
# SUPABASE_URL="your-supabase-url"
# SUPABASE_ANON_KEY="your-supabase-anon-key"
# SUPABASE_JWKS_URL="your-supabase-jwks-url"
